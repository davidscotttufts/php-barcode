{
    "name": "davidscotttufts/php-barcode",
    "description": "Generate 59 barcode types (QR, Data Matrix, Aztec, MaxiCode, PDF417, EAN/UPC, GS1-128, GS1 DataBar, Code 128, postal codes and more) as SVG, PNG, PDF, EPS or text. Pure PHP, GS1 validation, styled QR codes.",
    "type": "library",
    "license": "MIT",
    "keywords": ["barcode", "qr code", "qrcode", "datamatrix", "pdf417", "aztec", "maxicode", "ean13", "upc", "gs1", "gs1-128", "databar", "code128", "code39", "postal", "svg", "png", "pdf"],
    "homepage": "https://github.com/davidscotttufts/php-barcode",
    "authors": [
        {
            "name": "David S. Tufts",
            "homepage": "http://davidscotttufts.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "suggest": {
        "ext-gd": "Required for PNG, JPEG, GIF and WebP output (SVG and text output need no extensions).",
        "ext-mbstring": "Improves text centering for multi-byte input in the text renderer."
    },
    "autoload": {
        "psr-4": {
            "PhpBarcode\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PhpBarcode\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/barcode"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@cs", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
